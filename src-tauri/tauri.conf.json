{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nox",
  "version": "0.2.0",
  "identifier": "fr.theo.nox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nox",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#000000",
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
